# ==============================================================================
# AGENTIC AI ADAPTIVE PQC SMART DOOR LOCK - CONFIGURATION
# ==============================================================================

# Direct LAN REST API. Set this to the Windows PC's Wi-Fi IPv4 address; the
# ESP8266 must not use 127.0.0.1.
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_LAN_IP=
FLASK_BACKEND_URL=
DEVICE_API_BASE_URL=
DEVICE_API_USE_HTTPS=false

# Set these to unique values before the first run. Use a password manager or
# Python's secrets.token_urlsafe() to generate secrets; never commit .env.
DEVICE_ID=DOOR-001
DEVICE_SECRET=replace-with-a-long-random-device-secret
OWNER_SESSION_SECRET=replace-with-a-different-long-random-secret
OWNER_INITIAL_PASSWORD=replace-with-a-strong-owner-password
INITIAL_DOOR_PIN=replace-with-a-4-to-8-digit-pin
INITIAL_SECONDARY_DOOR_PIN=replace-with-a-different-4-to-8-digit-pin

# Google Sheets is optional export only; it is not on the operational path.
ENABLE_GOOGLE_SHEETS_EXPORT=false
GOOGLE_DEVICE_TOKEN=
GOOGLE_SPREADSHEET_ID=
GOOGLE_SCRIPT_URL=
GOOGLE_CREDENTIALS_FILE=
